{
  "name": "one-click-repair",
  "version": "0.7.3",
  "description": "通过 Codex Plugin 一键拉取、分析并确认后修复禅道前端 Bug",
  "type": "module",
  "bin": {
    "one-click-repair": "./scripts/npm-cli.mjs"
  },
  "files": [
    ".agents/plugins/marketplace.json",
    "plugins/one-click-repair",
    "scripts/bootstrap.mjs",
    "scripts/distribution-installer.mjs",
    "scripts/npm-cli.mjs",
    "scripts/plugin-manager.mjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiangQiuZhiYi/One-Click-Repair.git"
  },
  "homepage": "https://github.com/XiangQiuZhiYi/One-Click-Repair#readme",
  "bugs": {
    "url": "https://github.com/XiangQiuZhiYi/One-Click-Repair/issues"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "cli": "node scripts/npm-cli.mjs",
    "install-plugin": "node scripts/install-plugin.mjs",
    "install-skill": "node scripts/install-plugin.mjs",
    "setup": "node plugins/one-click-repair/skills/zentao-frontend-bugfix/scripts/bugfix.mjs setup",
    "start": "node plugins/one-click-repair/skills/zentao-frontend-bugfix/scripts/bugfix.mjs start",
    "bugfix": "node plugins/one-click-repair/skills/zentao-frontend-bugfix/scripts/bugfix.mjs",
    "mcp": "node plugins/one-click-repair/scripts/mcp-server.mjs",
    "build:mcp": "esbuild plugins/one-click-repair/scripts/mcp-server.mjs --bundle --platform=node --format=esm --target=node20 --outfile=plugins/one-click-repair/dist/mcp-server.mjs",
    "pretest": "npm run build:mcp",
    "test": "node --test",
    "prepack": "npm test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "esbuild": "^0.28.1",
    "zod": "^4.4.3"
  }
}
